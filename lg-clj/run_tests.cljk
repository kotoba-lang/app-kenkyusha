;; JVM-free observation gate — kbb --backend sci (kbb-first, adr-2609112000;
;; bb can no longer load .cljk sources after the cljk rename).
;;   bb test                (from lg-clj/; delegates to kbb)
;;   kbb --backend sci --classpath "src:test" run_tests.cljk
;;
;; Exit codes: 0 = all observation suites green; 1 = at least one failure or
;; error; 2 = the runner could not measure the outcome (never passes silently).
;; The smoke / research-loop suite is NOT silently skipped here — it needs
;; bb-only deps (babashka.http-client, cheshire) and is refused with a named
;; line below (refusal, not silence).
(ns lg-kenkyusha.host
  (:require [clojure.test :as t]
            [lg-kenkyusha.impact-observation-test]
            [lg-kenkyusha.event-observation-test]
            [lg-kenkyusha.funding-observation-test]
            [lg-kenkyusha.research-work-observation-test]
            [lg-kenkyusha.coverage-observation-test]))

(println "EXCLUDED-REFUSED lg-kenkyusha.smoke-test: requires bb-only deps (babashka.http-client, cheshire); run it under bb separately.")

(let [orig t/report
      fails (atom 0)
      nss '[lg-kenkyusha.impact-observation-test
            lg-kenkyusha.event-observation-test
            lg-kenkyusha.funding-observation-test
            lg-kenkyusha.research-work-observation-test
            lg-kenkyusha.coverage-observation-test]]
  (with-redefs [t/report (fn [m]
                           (when (#{:fail :error} (:type m)) (swap! fails inc))
                           (orig m))]
    (apply t/run-tests nss))
  (let [bad @fails]
    (println "SUITE-RESULT failing-assertions=" bad)
    (.exit js/process (cond (nil? bad) 2
                            (pos? bad) 1
                            :else 0))))
